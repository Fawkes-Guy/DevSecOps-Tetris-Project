pipeline {
    agent any
    environment {
        AWS_ACCOUNT_ID          = '458575205940' // Reemplaza con tu ID de cuenta
        AWS_REGION              = 'us-east-2'
        ECR_REPO_NAME           = 'tetris-app'
        TENABLE_API_TOKEN       = credentials('tenable-api-token')
        TENABLE_API_URL         = 'https://us.app.ermetic.com'
        GIT_REPO_URL            = 'https://github.com/Fawkes-Guy/devsecops-tetris-project.git'
    }
    tools {
        nodejs 'nodejs'
    }
    stages {
        stage('Checkout from Git') {
            steps {
                git branch: 'test', url: "${env.GIT_REPO_URL}"
            }
        }

        stage('Installing Dependencies & OWASP Scan') {
            steps {
                dir('Tetris-V1') {
                    sh 'npm install'
                    dependencyCheck additionalArguments: '--scan ./ --disableYarnAudit --disableNodeAudit', odcInstallation: 'DP-Check'
                    dependencyCheckPublisher pattern: '**/dependency-check-report.xml'
                }
            }
        }
        
        stage('Scan Kubernetes Manifests with TCS') {
            environment {
                TENABLE_CODE_BRANCH = "${env.CHANGE_BRANCH ?: env.GIT_BRANCH}"
                TENABLE_CODE_COMMIT_HASH = "${env.GIT_COMMIT}"
                TENABLE_CODE_COMMIT_USER = "${env.CHANGE_AUTHOR}"
                TENABLE_PIPELINE_RUN_ID = "${env.BUILD_ID}"
                TENABLE_PIPELINE_RUN_TRIGGER = "${currentBuild.getBuildCauses()[0].shortDescription}"
                TENABLE_PIPELINE_RUN_URL = "${env.BUILD_URL}"
                TENABLE_CODE_REPOSITORY_URL = "${env.GIT_REPO_URL}"
            }
            steps {
                dir('Manifest-file') {
                    script {
                        docker.image('tenable/cloud-security-scanner:latest').inside("--entrypoint='' --pull=always") {
                            sh '''
                               tenable iac scan --types kubernetes --fail-on-min-severity high
                            '''
                        }
                    }
                }
            }
        }

        stage('Build & Push Image to ECR') {
            steps {
                script {
                    def imageTag = "v${env.BUILD_NUMBER}"
                    def ecrImageUri = "${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.AWS_REGION}.amazonaws.com/${env.ECR_REPO_NAME}:${imageTag}"
                    sh "aws ecr get-login-password --region ${env.AWS_REGION} | docker login --username AWS --password-stdin ${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.AWS_REGION}.amazonaws.com"
                    dir('Tetris-V1') {
                        sh "docker build -t ${ecrImageUri} ."
                        sh "docker push ${ecrImageUri}"
                    }
                }
            }
        }

        stage('Scan Container Image with TCS') {
            // Volvemos a 'agent any' y moveremos la lógica de Docker a los 'steps'
            // como en el resto de tu pipeline.
            steps {
                script {
                    def imageTag = "v${env.BUILD_NUMBER}"
                    def ecrImageUri = "${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.AWS_REGION}.amazonaws.com/${env.ECR_REPO_NAME}:${imageTag}"
                    
                    // --- ESTRUCTURA ALINEADA A LA DOCUMENTACIÓN DE TENABLE ---
                    docker.image('tenable/cloud-security-scanner:latest').inside("--entrypoint='' --pull=always -u 0") {
                        sh """
                           tenable container-image scan \\
                                --name "${ecrImageUri}" \\
                                --fail-on-min-severity high
                        """
                    }
                }
            }
        }
        
        stage('Update Manifest & Trigger ArgoCD') {
            steps {
                dir('Manifest-file') {
                    script {
                        // --- CORRECCIÓN: Definimos las variables de Groovy aquí, fuera del 'sh' ---
                        def imageTag = "v${env.BUILD_NUMBER}"
                        def ecrImageUri = "${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.AWS_REGION}.amazonaws.com/${env.ECR_REPO_NAME}:${imageTag}"

                        withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
                            // --- El bloque 'sh' ahora solo contiene comandos de shell y usa las variables ya definidas ---
                            sh """
                                git config user.email "cesard.romero@gmail.com"
                                git config user.name "Fawkes-Guy"
                                
                                # Reemplazamos la línea de la imagen usando la variable 'ecrImageUri'
                                sed -i "s#image: .*#image: ${ecrImageUri}#g" deployment-service.yml
                                
                                git add deployment-service.yml
                                # Usamos la variable 'imageTag' en el mensaje del commit
                                git commit -m "Update deployment image to ${imageTag}"
                                git push https://${GITHUB_TOKEN}@github.com/Fawkes-Guy/devsecops-tetris-project.git HEAD:test
                            """
                        }
                    }
                }
            }
        }
    }
}