properties([
    parameters([
        string(defaultValue: 'variables.tfvars', description: 'Specify the file name', name: 'File-Name'),
        choice(choices: ['apply', 'destroy'], description: 'Select Terraform action', name: 'Terraform-Action')
    ])
])

pipeline {
    agent any
    environment {
        TENABLE_API_TOKEN = credentials('tenable-api-token')
        TENABLE_API_URL = 'https://us.app.ermetic.com'
        AWS_REGION = 'us-east-2'
    }
    stages {
        stage('Checkout from Git') {
            steps {
                git branch: 'test', url: 'https://github.com/Fawkes-Guy/devsecops-tetris-project.git'
            }
        }
        
        stage('Tenable IaC Scan') {
            environment {
                TENABLE_CODE_BRANCH = "${env.CHANGE_BRANCH ?: env.GIT_BRANCH}"
                TENABLE_CODE_COMMIT_HASH = "${env.GIT_COMMIT}"
                TENABLE_CODE_COMMIT_USER = "${env.CHANGE_AUTHOR}"
                TENABLE_PIPELINE_RUN_ID = "${env.BUILD_ID}"
                TENABLE_PIPELINE_RUN_TRIGGER = "${currentBuild.getBuildCauses()[0].shortDescription}"
                TENABLE_PIPELINE_RUN_URL = "${env.BUILD_URL}"
                TENABLE_CODE_REPOSITORY_URL = 'https://github.com/Fawkes-Guy/devsecops-tetris-project.git'
            }
            steps {
                dir('EKS-TF') {
                    script {
                        docker.image('tenable/cloud-security-scanner:latest').inside("--entrypoint='' --pull=always") {
                            sh '''
                                tenable iac scan --no-color \\
                                    --fail-on-min-severity=high \\
                                    --output-file-formats JUnit \\
                                    --output-path .
                            '''
                            junit skipPublishingChecks: true, testResults: 'results.junit.xml'
                        }
                    }
                }
            }
        }
        
        stage('Initializing Terraform') {
            steps {
                dir('EKS-TF') {
                    sh 'terraform init'
                }
            }
        }
        
        stage('Validate Terraform Code') {
            steps {
                dir('EKS-TF') {
                    sh 'terraform validate'
                }
            }
        }
        
        stage('Terraform Plan') {
            steps {
                dir('EKS-TF') {
                    sh "terraform plan -var-file=${params.'File-Name'}"
                }
            }
        }
        
        stage('Terraform Action') {
            steps {
                dir('EKS-TF') {
                    script {
                        if (params.'Terraform-Action' == 'apply') {
                            sh "terraform apply -auto-approve -var-file=${params.'File-Name'}"
                        } else if (params.'Terraform-Action' == 'destroy') {
                            sh "terraform destroy -auto-approve -var-file=${params.'File-Name'}"
                        } else {
                            error "Invalid value for Terraform-Action: ${params.'Terraform-Action'}"
                        }
                    }
                }
            }
        }
        
        stage('Deploy Tenable Kubernetes Security') {
            steps {
                dir('EKS-TF') {
                    script {
                        def awsAccountId = '458575205940' // Reemplaza con tu ID de cuenta
                        def imageName = "${awsAccountId}.dkr.ecr.${env.AWS_REGION}.amazonaws.com/tetrisv1:1.0" // Tu imagen de CI/CD

                        sh "aws ecr get-login-password --region ${env.AWS_REGION} | docker login --username AWS --password-stdin ${awsAccountId}.dkr.ecr.${env.AWS_REGION}.amazonaws.com"
                        sh "aws eks update-kubeconfig --name Tetris-EKS-Cluster --region ${env.AWS_REGION} --kubeconfig ./kubeconfig.yaml"

                        withEnv([
                            "KUBECONFIG=./kubeconfig.yaml",
                            "HELM_CONFIG_HOME=./.helm_home",
                            "HELM_CACHE_HOME=./.helm_home",
                            "HELM_DATA_HOME=./.helm_home"
                        ]) {
                            docker.image(imageName).inside("--entrypoint=''") {
                                withCredentials([string(credentialsId: 'tenable-sensor-token', variable: 'TENABLE_SENSOR_API_TOKEN')]) {
                                    sh '''
                                        echo "Waiting for all EKS nodes to be Ready..."
                                        kubectl wait --for=condition=Ready node --all --timeout=5m
                                        echo "All nodes are Ready. Proceeding with Helm install."

                                        helm repo add tenable https://charts.tenable.com
                                        helm repo update tenable
                                        
                                        helm upgrade --install tenable-cloud-security-kubernetes-cluster tenable/cloud-security-kubernetes-cluster \\
                                            -n tenable-cloud-security-kubernetes-cluster --create-namespace \\
                                            --timeout 10m \\
                                            --set apiKeyToken="${TENABLE_SENSOR_API_TOKEN}" \\
                                            --set apiUrl="${TENABLE_API_URL}" \\
                                            --set admissionController.enabled=true \\
                                            --set sensor.enabled=true
                                    '''
                                }
                            }
                        }
                    }
                }
            }
        }
        
        stage('Tenable IaC Sync') {
            environment {
                TENABLE_CODE_BRANCH = "${env.CHANGE_BRANCH ?: env.GIT_BRANCH}"
                TENABLE_CODE_COMMIT_HASH = "${env.GIT_COMMIT}"
                TENABLE_CODE_COMMIT_USER = "${env.CHANGE_AUTHOR}"
                TENABLE_PIPELINE_RUN_ID = "${env.BUILD_ID}"
                TENABLE_PIPELINE_RUN_TRIGGER = "${currentBuild.getBuildCauses()[0].shortDescription}"
                TENABLE_PIPELINE_RUN_URL = "${env.BUILD_URL}"
                TENABLE_CODE_REPOSITORY_URL = 'https://github.com/Fawkes-Guy/devsecops-tetris-project.git'
            }
            steps {
                dir('EKS-TF') {
                    script {
                        sh 'terraform state pull > terraform.tfstate'
                        docker.image('tenable/cloud-security-scanner:latest').inside("--entrypoint='' --pull=always") {
                            sh '''
                                tenable iac sync terraform \\
                                    --no-color \\
                                    --path . \\
                                    --state-file-path terraform.tfstate
                            '''
                        }
                    }
                }
            }
        }
    }
}